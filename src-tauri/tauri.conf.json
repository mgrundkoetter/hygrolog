{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Hygrolog",
  "version": "1.0.0",
  "identifier": "app.hygrolog.desktop",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Hygrolog",
        "width": 1280,
        "height": 880,
        "minWidth": 900,
        "minHeight": 640,
        "resizable": true,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "Utility",
    "shortDescription": "Auswertung für Elitech-RC-Temperatur-/Feuchtelogger",
    "longDescription": "Importiert die CSV-Berichte von Elitech-RC-Loggern und stellt Temperatur und Luftfeuchte zusammen mit Wetterdaten und Sonnenzeiten dar.",
    "copyright": "MIT License"
  }
}
